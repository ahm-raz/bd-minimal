NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Invite emails need a sending domain (custom SMTP in Supabase). Leave unset until then; set to "on" to enable.
# EMAIL_INVITES=on

# Google Calendar (M11, docs/10). Server only. The feature is hidden unless GOOGLE_CALENDAR=on.
# GOOGLE_CALENDAR=on
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_KEY=     # 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Google Search Console HTML-tag token for OAuth verification (only the content="…" value); rendered on the homepage.
GOOGLE_SITE_VERIFICATION=
